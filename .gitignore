# dependencies
node_modules/

# build / deploy
dist/
.vercel/

# rust / tauri
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/

# generated test fixtures (regenerate via scripts/make-fixtures.mjs)
src-tauri/fixtures/*
!src-tauri/fixtures/README.md

# logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# .claude/ = bruit-machine ignoré, SAUF rules/ (méthode portable versionnée)
# et scripts/ (outils CDP réutilisables, committés — voir cdp.cjs).
# Limitation Git connue (vérifiée 2026-07-20) : ces négations ne suffisent PAS
# à faire apparaître un NOUVEAU fichier de ces sous-dossiers comme trackable —
# Git refuse de redescendre dans un dossier parent exclu. Seuls les fichiers
# déjà trackés (ajoutés une fois via `git add -f`) y échappent. Tout nouveau
# fichier sous rules/ ou scripts/ nécessite donc un `git add -f` explicite.
.claude/
!.claude/rules/
!.claude/rules/**
!.claude/scripts/
!.claude/scripts/**
.codex/
.agents/

# installed agent skills (per-machine tooling, not project code)
.github/skills/
skills-lock.json

# tooling caches (per-machine, not project code)
.impeccable/

.superpowers/

# scratch/test copies (may contain real Rekordbox master.db, never committed)
scratchpad/
scratchpad-verif/

# real Rekordbox master.db backups (per-machine, never committed)
Sift-Rekordbox-Backups/
